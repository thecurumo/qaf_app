            'دیوان اشعار': { sub: 'حافظ شیرازی • قرن ۸ هـ.ق' }
        };
        const VERSE_META = {
            1: { text: 'الا یا اَیها السّاقی اَدِر کأساً و ناوِلها<br>که عشق آسان نمود اوّل ولی افتاد مشکل‌ها', sub: 'حافظ شیرازی | دیوان اشعار' },
            2: { text: 'به بویِ نافه‌ای کآخر صبا زان طُرّه بگشاید<br>ز تابِ جَعدِ مشکینش چه خون افتاد در دل‌ها', sub: 'حافظ شیرازی | دیوان اشعار' },
            3: { text: 'به می سجاده رنگین کن گرت پیرِ مغان گوید<br>که سالک بی‌خبر نبود ز راه و رسمِ منزل‌ها', sub: 'حافظ شیرازی | دیوان اشعار' },
            4: { text: 'مرا در منزلِ جانان چه امنِ عیش چون هر دم<br>جرس فریاد می‌دارد که بربندید محمل‌ها', sub: 'حافظ شیرازی | دیوان اشعار' },
            5: { text: 'شبِ تاریک و بیمِ موج و گردابی چنین هایل<br>کجا دانند حالِ ما سبکبارانِ ساحل‌ها', sub: 'حافظ شیرازی | دیوان اشعار' },
            6: { text: 'همه کارم ز خودکامی به بدنامی کشید آخر<br>نهان کی ماند آن رازی کز او سازند محفل‌ها', sub: 'حافظ شیرازی | دیوان اشعار' }
        };
        const POEM_META = {
            'غزل شماره ۱': { sub: 'حافظ شیرازی | دیوان اشعار', text: 'الا یا اَیها السّاقی اَدِر کأساً و ناوِلها<br>که عشق آسان نمود اوّل ولی افتاد مشکل‌ها' }
        };

        /* --- RENDER: BOOKMARKS (PROFILE) --- */
        function renderBookmarks() {
            const container = document.getElementById('bookmarksUnitsList');
            if (!container) return;
            const poets = JSON.parse(localStorage.getItem('qaf_bookmarked_poets') || '[]');
            const works = JSON.parse(localStorage.getItem('qaf_bookmarked_works') || '[]');
            const verses = JSON.parse(localStorage.getItem('qaf_bookmarked_verses') || '[]');
            const poems = JSON.parse(localStorage.getItem('qaf_bookmarked_poems') || '[]');

            if (poets.length === 0 && works.length === 0 && verses.length === 0 && poems.length === 0) {
                container.innerHTML = emptyStateHTML(
                    ICON_BOOKMARK,
                    'هنوز نشانی ذخیره نکرده‌اید',
                    'سخنوران، آثار یا ابیات مورد علاقه خود را نشان‌گذاری کنید تا اینجا نمایش داده شوند.'
                );
                return;
            }

            // Bookmarked items are rendered using the same card structure as global search results.
            let html = '';
            poets.forEach(name => {
                const sub = (POET_META[name] && POET_META[name].sub) || '';
                html += `<div class="bookmark-unit-card" data-category="all">
                    <div class="bookmark-unit-header">
                        <span class="bookmark-type-badge">سخنور</span>
                        <button type="button" class="remove-bookmark-btn" onclick="event.stopPropagation(); removeBookmarkUnit(this, '${name}', 'poet')">✕ حذف</button>
                    </div>
                    <div onclick="navigateTo('view-poet-detail', {poet: '${name}'})">
                        <div class="bookmark-unit-title">${name}</div>
                        ${sub ? `<div class="bookmark-unit-sub">${sub}</div>` : ''}
                    </div>
                    <div class="bookmark-unit-footer">
                        <span class="bookmark-action-link" onclick="navigateTo('view-poet-detail', {poet: '${name}'})">مشاهده ←</span>
                    </div>
                </div>`;
            });
            works.forEach(name => {
                const sub = (WORK_META[name] && WORK_META[name].sub) || '';
                html += `<div class="bookmark-unit-card" data-category="epic">
                    <div class="bookmark-unit-header">
                        <span class="bookmark-type-badge">اثر</span>
                        <button type="button" class="remove-bookmark-btn" onclick="event.stopPropagation(); removeBookmarkUnit(this, '${name}', 'work')">✕ حذف</button>
                    </div>
                    <div onclick="navigateTo('view-work-flat')">
                        <div class="bookmark-unit-title">${name}</div>
                        ${sub ? `<div class="bookmark-unit-sub">${sub}</div>` : ''}
                    </div>
                    <div class="bookmark-unit-footer">
                        <span class="bookmark-action-link" onclick="navigateTo('view-work-flat')">مطالعه ←</span>
                    </div>
                </div>`;
            });
            poems.forEach(title => {
                const meta = POEM_META[title] || {};
                const text = meta.text || title;
                const sub = meta.sub || '';
                html += `<div class="bookmark-unit-card" data-category="mystic">
                    <div class="bookmark-unit-header">
                        <span class="bookmark-type-badge">شعر</span>
                        <button type="button" class="remove-bookmark-btn" onclick="event.stopPropagation(); removeBookmarkUnit(this, '${title}', 'poem')">✕ حذف</button>
                    </div>
                    <div onclick="navigateTo('view-poem-reader')">
                        <div class="bookmark-unit-title">${title}</div>
                        ${sub ? `<div class="bookmark-unit-sub">${sub}</div>` : ''}
                    </div>
                    <div class="bookmark-unit-footer">
                        <span class="bookmark-action-link" onclick="navigateTo('view-poem-reader')">خوانش ←</span>
                    </div>
                </div>`;
            });
            verses.forEach(id => {
                const meta = VERSE_META[id] || {};
                const text = meta.text || `بیت ${id}`;
                const sub = meta.sub || '';
                html += `<div class="bookmark-unit-card" data-category="mystic">
                    <div class="bookmark-unit-header">
                        <span class="bookmark-type-badge">تک‌بیت</span>
                        <button type="button" class="remove-bookmark-btn" onclick="event.stopPropagation(); removeBookmarkUnit(this, '${id}', 'verse')">✕ حذف</button>
                    </div>
                    <div onclick="navigateTo('view-poem-reader')">
                        <div class="bookmark-unit-title" style="font-weight: 400; font-size: 13.5px; line-height: 1.85;">«${text}»</div>
                        ${sub ? `<div class="bookmark-unit-sub">${sub}</div>` : ''}
                    </div>
                    <div class="bookmark-unit-footer">
                        <span class="bookmark-action-link" onclick="navigateTo('view-poem-reader')">خوانش ←</span>
                    </div>
                </div>`;
            });
            container.innerHTML = html;
        }

        /* --- RENDER: READING HISTORY (PROFILE) --- */
        function renderReadingHistory() {
            const container = document.getElementById('historyListStream');
            if (!container) return;
            const history = JSON.parse(localStorage.getItem('qaf_reading_history') || '[]');

            if (history.length === 0) {
                container.innerHTML = emptyStateHTML(
                    ICON_HISTORY,
                    'تاریخچه خوانش خالی است',
                    'اشعاری که مطالعه می‌کنید، برای دسترسی سریع در اینجا ثبت می‌شوند.'
                );
                return;
            }

            container.innerHTML = history.map(item => `
                <div class="history-item-row" onclick="navigateTo('view-poem-reader')">
                    <div class="history-item-info">
                        <span class="history-poem-title">${item.title}</span>
                        <span class="history-poem-meta">${item.author} • ${item.workTitle}</span>
                    </div>
                    <div class="history-action-side">
                        <span class="history-read-link">بازخوانی ←</span>
                    </div>
                </div>
            `).join('');
        }

        function openCreateListModal() {
            document.getElementById('createListModal').classList.add('open');
            setTimeout(() => { document.getElementById('newListName').focus(); }, 100);
        }

        function closeCreateListModal() {
            document.getElementById('createListModal').classList.remove('open');
            document.getElementById('newListName').value = '';
        }

        function saveNewList() {
            const name = document.getElementById('newListName').value.trim();
            if (!name) return;
            const row = document.getElementById('categoriesScrollRow');
            const newBtn = document.createElement('button');
            newBtn.type = 'button';
            newBtn.className = 'collection-chip';
            newBtn.innerHTML = `<span>${name}</span>`;
            const randomId = 'custom_' + Date.now();
            newBtn.onclick = function() { filterByCollection(randomId, this); };
            const createBtn = row.querySelector('.create-list-action-chip');
            row.insertBefore(newBtn, createBtn);
            closeCreateListModal();
        }

        function exportDataBackup() {
            const backupData = {
                app: "QAF_LITERARY_ARCHIVE",
                timestamp: new Date().toISOString(),
                bookmarks: JSON.parse(localStorage.getItem('qaf_bookmarked_poems') || '[]'),
                poetBookmarks: JSON.parse(localStorage.getItem('qaf_bookmarked_poets') || '[]'),
                workBookmarks: JSON.parse(localStorage.getItem('qaf_bookmarked_works') || '[]'),
                verseBookmarks: JSON.parse(localStorage.getItem('qaf_bookmarked_verses') || '[]'),
                lastRead: JSON.parse(localStorage.getItem('qaf_last_read_poem') || '{}')
            };
            const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(backupData, null, 2));
            const dl = document.createElement('a');
            dl.setAttribute("href", dataStr);
            dl.setAttribute("download", `qaf_backup_${new Date().toISOString().slice(0, 10)}.json`);
            document.body.appendChild(dl);
            dl.click();
            dl.remove();
        }

        function importDataBackup(event) {
            const file = event.target.files[0];
            if (!file) return;
            const reader = new FileReader();
            reader.onload = function(e) {
                try {
                    const parsed = JSON.parse(e.target.result);
                    if (parsed.app === "QAF_LITERARY_ARCHIVE") {
                        if (parsed.bookmarks) localStorage.setItem('qaf_bookmarked_poems', JSON.stringify(parsed.bookmarks));
                        if (parsed.poetBookmarks) localStorage.setItem('qaf_bookmarked_poets', JSON.stringify(parsed.poetBookmarks));
                        if (parsed.workBookmarks) localStorage.setItem('qaf_bookmarked_works', JSON.stringify(parsed.workBookmarks));
                        if (parsed.verseBookmarks) localStorage.setItem('qaf_bookmarked_verses', JSON.stringify(parsed.verseBookmarks));
                        if (parsed.lastRead) localStorage.setItem('qaf_last_read_poem', JSON.stringify(parsed.lastRead));
                        alert('پشتیبان با موفقیت بازیابی شد.');
                    }
                } catch (err) {}
            };
            reader.readAsText(file);
        }

        /* --- CRYPTO ADDRESS COPY --- */
        function copyCryptoAddress(elementId, btn) {
            const text = document.getElementById(elementId).innerText.trim();
            navigator.clipboard.writeText(text);
            const span = btn.querySelector('span');
            span.innerText = 'رونوشت شد';
            setTimeout(() => { span.innerText = 'رونوشت'; }, 1800);
        }

        /* --- GLOBAL KEYBOARD ESCAPE LISTENER --- */
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') {
                if (document.body.classList.contains('zen-active')) {
                    toggleZenMode(false);
                } else {
                    closeGlobalSearch();
                    closeDrawer();
                    closeCreateListModal();
                }
            }
        });

        // Initialize App
        initTheme();
        renderRecentReading();
        initDatabaseTest();

        async function renderFeaturedPoets() {
            try {
                const sqlitePlugin = Capacitor.Plugins.CapacitorSQLite;
                const featuredIds = [2, 3, 4, 5, 7, 9, 6, 8];

                const result = await sqlitePlugin.query({
                    database: 'qaf',
                    statement: "SELECT id, name, birth_year, death_year, birthplace FROM poet WHERE id IN (" + featuredIds.join(',') + ")",
                    values: [],
                    readonly: true
                });

                const poets = result.values || [];
                const grid = document.querySelector('#view-home .poets-grid');
                if (!grid) return;

                grid.innerHTML = poets.map(poet => {
                    const initial = poet.name ? poet.name.trim().charAt(0) : '؟';
                    const dateRange = (poet.birth_year && poet.death_year)
                        ? toPersianDigits(poet.birth_year) + " — " + toPersianDigits(poet.death_year) + " هـ.ق"
                        : '';
                    const origin = poet.birthplace || '';
                    const name = poet.name || 'نامشخص';

                    return '<div class="poet-card" onclick="navigateTo(&#39;view-poet-detail&#39;, {poetId: ' + poet.id + '})">' +
                            '<div class="poet-avatar">' + initial + '</div>' +
                            '<div class="poet-name">' + name + '</div>' +
                            '<div class="poet-dates">' + dateRange + '</div>' +
                            '<div class="poet-origin">' + origin + '</div>' +
                        '</div>';
                    ;
                }).join('');

            } catch (err) {
                console.error('Error rendering featured poets:', err);
            }
        }

        function toPersianDigits(num) {
            const persianDigits = ['۰','۱','۲','۳','۴','۵','۶','۷','۸','۹'];
            return String(num).replace(/[0-9]/g, d => persianDigits[d]);
        }

                async function initDatabaseTest() {
            try {
                const sqlitePlugin = Capacitor.Plugins.CapacitorSQLite;

                // Copy bundled databases from public/assets/databases/
                // to the SQLite plugin's internal database directory.
                await sqlitePlugin.copyFromAssets(true);
                console.log('Database copied from assets successfully');

                // Open the copied qaf database.
                await sqlitePlugin.createConnection({
                    database: 'qaf',
                    version: 1,
                    encrypted: false,
                    mode: 'no-encryption',
                    readonly: false
                });

                await sqlitePlugin.open({
                    database: 'qaf',
                    readonly: false
                });

                // Verify that the expected schema exists.
                const result = await sqlitePlugin.query({
                    database: 'qaf',
                    statement: 'SELECT COUNT(*) as cnt FROM poet',
                    values: [],
                    readonly: false
                });

                const count = result.values && result.values[0]
                    ? result.values[0].cnt
                    : '؟';

                console.log('Database opened successfully. Poet count:', count);

                const subtext = document.getElementById('topbarSubtext');
                if (subtext) {
                    subtext.innerText = 'تعداد شاعران: ' + count;
                }

                await renderFeaturedPoets();

            } catch (err) {
                console.error('Database initialization error:', err);

                const subtext = document.getElementById('topbarSubtext');
                if (subtext) {
                    subtext.innerText = 'خطا: ' + (err.message || err);
                }
            }
        }
        renderBookmarks();
        renderReadingHistory();
    </script>
