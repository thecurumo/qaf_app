    <!-- ============================================================
         13. JAVASCRIPT LOGIC & SPA ROUTER
         ============================================================ -->
    <script>
        /* --- SPA ROUTING & NAVIGATION --- */
        function navigateTo(viewId, params = {}) {
            document.querySelectorAll('.spa-view').forEach(v => v.classList.remove('active-view'));
            const targetView = document.getElementById(viewId);
            if (targetView) {
                targetView.classList.add('active-view');
                window.scrollTo({ top: 0, behavior: 'smooth' });
            }

            // Update Top Bar Subtitle
            const subtext = document.getElementById('topbarSubtext');
            if (viewId === 'view-home') subtext.innerText = 'آرشیو ادبیات پارسی';
            else if (viewId === 'view-poets') subtext.innerText = 'دانشنامه سخنوران';
            else if (viewId === 'view-works') subtext.innerText = 'گنجینه آثار و دیوان‌ها';
            else if (viewId === 'view-poet-detail') subtext.innerText = 'اطلاعات سخنور';
            else if (viewId === 'view-work-hierarchical') subtext.innerText = 'اطلاعات اثر';
            else if (viewId === 'view-work-flat') subtext.innerText = 'اطلاعات اثر';
            else if (viewId === 'view-poem-reader') subtext.innerText = 'خوانش شعر';
            else if (viewId === 'view-search') subtext.innerText = 'نتایج جستجو';
            else if (viewId === 'view-profile') subtext.innerText = 'بایگانی و نشان‌ها';
            else if (viewId === 'view-about') subtext.innerText = 'درباره قاف';

            // Active Drawer Link Highlighting
            document.querySelectorAll('.drawer-nav-item').forEach(el => el.classList.remove('active'));
            if (viewId === 'view-home') document.getElementById('navItem-home')?.classList.add('active');
            if (viewId === 'view-poets') document.getElementById('navItem-poets')?.classList.add('active');
            if (viewId === 'view-works') document.getElementById('navItem-works')?.classList.add('active');
            if (viewId === 'view-profile') document.getElementById('navItem-profile')?.classList.add('active');
            if (viewId === 'view-about') document.getElementById('navItem-about')?.classList.add('active');

            // Handle View-Specific Param Logic
            if (viewId === 'view-profile') {
                renderBookmarks();
                renderReadingHistory();
                if (params.tab) {
                    const btn = document.querySelectorAll('.workspace-tab-btn')[params.tab === 'history' ? 1 : 0];
                    switchMainTab(params.tab, btn);
                }
            }

            if (viewId === 'view-home') {
                renderRecentReading();
            }

            if (viewId === 'view-poet-detail' && params.poetId) {
                document.getElementById('poetDetailName').innerText = 'در حال بارگذاری...';
                window.currentPoetId = params.poetId;
            }

            if (viewId === 'view-poem-reader') {
                recordLastReading();
            }
        }

        /* --- THEME LOGIC --- */
        function initTheme() {
            const savedTheme = localStorage.getItem('theme');
            if (savedTheme) {
                document.documentElement.setAttribute('data-theme', savedTheme);
            } else if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
                document.documentElement.setAttribute('data-theme', 'dark');
            }
        }

        function toggleTheme() {
            const currentTheme = document.documentElement.getAttribute('data-theme');
            const targetTheme = currentTheme === 'dark' ? 'light' : 'dark';
            document.documentElement.setAttribute('data-theme', targetTheme);
            localStorage.setItem('theme', targetTheme);
        }

        /* --- DRAWER MENU --- */
        function openDrawer() {
            document.getElementById('navDrawer').classList.add('is-open');
            document.getElementById('menuToggleBtn').classList.add('is-active');
            document.body.style.overflow = 'hidden';
        }

        function closeDrawer() {
            document.getElementById('navDrawer').classList.remove('is-open');
            document.getElementById('menuToggleBtn').classList.remove('is-active');
            document.body.style.overflow = '';
        }

        /* --- GLOBAL SEARCH MODAL --- */
        function openGlobalSearch() {
            document.getElementById('searchOverlay').classList.add('is-open');
            document.getElementById('searchToggleBtn').classList.add('is-active');
            document.body.style.overflow = 'hidden';
            setTimeout(() => {
                document.getElementById('globalSearchInput').focus();
            }, 180);
        }

        function closeGlobalSearch() {
            document.getElementById('searchOverlay').classList.remove('is-open');
            document.getElementById('searchToggleBtn').classList.remove('is-active');
            document.body.style.overflow = '';
        }

        function resetGlobalSearchFilters() {
            document.getElementById('globalScopeFilter').selectedIndex = 0;
            document.getElementById('globalPoetFilter').selectedIndex = 0;
            document.getElementById('globalCenturyFilter').selectedIndex = 0;
            document.getElementById('globalSearchInput').value = '';
        }

        function executeGlobalSearch() {
            const val = document.getElementById('globalSearchInput').value.trim();
            closeGlobalSearch();
            navigateTo('view-search');
            document.getElementById('searchResultsInput').value = val;
            performLiveFilter();
        }

        /* --- SEARCH VIEW LIVE FILTERING --- */
        function performLiveFilter() {
            const query = document.getElementById('searchResultsInput').value.trim().toLowerCase();
            const selectedScope = document.getElementById('scopeSelect').value;
            const selectedPoet = document.getElementById('poetSelect').value;
            const selectedCentury = document.getElementById('centurySelect').value;

            const sections = [
                { sec: document.getElementById('poetsResultSection'), grid: document.getElementById('poetsGridResults'), empty: document.getElementById('poetsEmptyMsg'), scope: 'poets' },
                { sec: document.getElementById('worksResultSection'), grid: document.getElementById('worksGridResults'), empty: document.getElementById('worksEmptyMsg'), scope: 'works' },
                { sec: document.getElementById('versesResultSection'), grid: document.getElementById('versesGridResults'), empty: document.getElementById('versesEmptyMsg'), scope: 'verses' }
            ];

            sections.forEach(({ sec, grid, empty, scope }) => {
                const isScopeMatch = (selectedScope === 'all' || selectedScope === scope);
                if (!isScopeMatch) {
                    sec.style.display = 'none';
                    return;
                }
                sec.style.display = 'flex';
                const cards = Array.from(grid.children);
                let visibleCount = 0;

                cards.forEach(card => {
                    const text = card.innerText.toLowerCase();
                    const cardPoet = card.getAttribute('data-poet') || card.getAttribute('data-name') || '';
                    const cardCentury = card.getAttribute('data-century') || '';

                    const matchesQuery = !query || text.includes(query);
                    const matchesPoet = !selectedPoet || cardPoet.includes(selectedPoet);
                    const matchesCentury = !selectedCentury || cardCentury === selectedCentury;

                    if (matchesQuery && matchesPoet && matchesCentury) {
                        card.style.display = 'flex';
                        visibleCount++;
                    } else {
                        card.style.display = 'none';
                    }
                });

                if (visibleCount === 0) {
                    grid.style.display = 'none';
                    empty.style.display = 'block';
                } else {
                    grid.style.display = 'flex';
                    empty.style.display = 'none';
                }
            });
        }

        function resetSearchPageFilters() {
            document.getElementById('searchResultsInput').value = '';
            document.getElementById('scopeSelect').selectedIndex = 0;
            document.getElementById('poetSelect').selectedIndex = 0;
            document.getElementById('centurySelect').selectedIndex = 0;
            performLiveFilter();
        }

        /* --- POETS DIRECTORY FILTERING --- */
        function filterPoetsLive() {
            const searchQuery = document.getElementById('poetSearchInput').value.trim().toLowerCase();
            const selectedCentury = document.getElementById('poetCenturyFilter').value;
            const selectedCity = document.getElementById('poetCityFilter').value;
            const selectedSort = document.getElementById('poetSortFilter').value;
            
            const grid = document.getElementById('poetsGrid');
            const cards = Array.from(grid.getElementsByClassName('poet-card'));
            const emptyBox = document.getElementById('poetsEmptyBox');
            let visibleCount = 0;

            cards.forEach(card => {
                const name = (card.getAttribute('data-name') || '').toLowerCase();
                const century = card.getAttribute('data-century') || '';
                const city = card.getAttribute('data-city') || '';
                const textContent = card.innerText.toLowerCase();

                const matchesSearch = !searchQuery || name.includes(searchQuery) || textContent.includes(searchQuery);
                const matchesCentury = !selectedCentury || century === selectedCentury;
                const matchesCity = !selectedCity || (city && city.includes(selectedCity));

                if (matchesSearch && matchesCentury && matchesCity) {
                    card.style.display = 'flex';
                    visibleCount++;
                } else {
                    card.style.display = 'none';
                }
            });

            cards.sort((a, b) => {
                if (selectedSort === 'historical-asc') {
                    return parseInt(a.getAttribute('data-year') || '0') - parseInt(b.getAttribute('data-year') || '0');
                } else if (selectedSort === 'historical-desc') {
                    return parseInt(b.getAttribute('data-year') || '0') - parseInt(a.getAttribute('data-year') || '0');
                } else if (selectedSort === 'alphabetical') {
                    return (a.getAttribute('data-name') || '').localeCompare(b.getAttribute('data-name') || '', 'fa');
                }
                return 0;
            });
            cards.forEach(card => grid.appendChild(card));

            emptyBox.style.display = (visibleCount === 0) ? 'flex' : 'none';
        }

        function resetPoetDirectoryFilters() {
            document.getElementById('poetSearchInput').value = '';
            document.getElementById('poetCenturyFilter').selectedIndex = 0;
            document.getElementById('poetCityFilter').selectedIndex = 0;
            document.getElementById('poetSortFilter').selectedIndex = 0;
            filterPoetsLive();
        }

        /* --- WORKS DIRECTORY FILTERING --- */
        function filterWorksLive() {
            const searchQuery = document.getElementById('workSearchInput').value.trim().toLowerCase();
            const selectedPoet = document.getElementById('workPoetFilter').value;
            const selectedCentury = document.getElementById('workCenturyFilter').value;
            const selectedSort = document.getElementById('workSortFilter').value;
            
            const grid = document.getElementById('worksGrid');
            const cards = Array.from(grid.getElementsByClassName('work-card'));
            const emptyBox = document.getElementById('worksEmptyBox');
            let visibleCount = 0;

            cards.forEach(card => {
                const title = (card.getAttribute('data-title') || '').toLowerCase();
                const poet = card.getAttribute('data-poet') || '';
                const century = card.getAttribute('data-century') || '';
                const textContent = card.innerText.toLowerCase();

                const matchesSearch = !searchQuery || title.includes(searchQuery) || textContent.includes(searchQuery);
                const matchesPoet = !selectedPoet || poet.includes(selectedPoet);
                const matchesCentury = !selectedCentury || century === selectedCentury;

                if (matchesSearch && matchesPoet && matchesCentury) {
                    card.style.display = 'flex';
                    visibleCount++;
                } else {
                    card.style.display = 'none';
                }
            });

            cards.sort((a, b) => {
                if (selectedSort === 'historical-asc') {
                    return parseInt(a.getAttribute('data-year') || '0') - parseInt(b.getAttribute('data-year') || '0');
                } else if (selectedSort === 'historical-desc') {
                    return parseInt(b.getAttribute('data-year') || '0') - parseInt(a.getAttribute('data-year') || '0');
                } else if (selectedSort === 'alphabetical') {
                    return (a.getAttribute('data-title') || '').localeCompare(b.getAttribute('data-title') || '', 'fa');
                }
                return 0;
            });
            cards.forEach(card => grid.appendChild(card));

            emptyBox.style.display = (visibleCount === 0) ? 'flex' : 'none';
        }

        function resetWorkDirectoryFilters() {
            document.getElementById('workSearchInput').value = '';
            document.getElementById('workPoetFilter').selectedIndex = 0;
            document.getElementById('workCenturyFilter').selectedIndex = 0;
            document.getElementById('workSortFilter').selectedIndex = 0;
            filterWorksLive();
        }

        /* --- FLAT WORK LIVE FILTER --- */
        function filterFlatPoemsLive() {
            const query = document.getElementById('flatSearchInput').value.trim().toLowerCase();
            const list = document.getElementById('flatPoemsList');
            const cards = Array.from(list.getElementsByClassName('poem-flat-card'));

            cards.forEach(card => {
                const text = card.innerText.toLowerCase();
                card.style.display = (!query || text.includes(query)) ? 'flex' : 'none';
            });
        }

        /* --- POEM READER: ZEN MODE, COPY, BOOKMARKS --- */
        function toggleZenMode(enable) {
            document.body.classList.toggle('zen-active', enable);
            const btn = document.getElementById('zenToggleBtn');
            if (btn) btn.classList.toggle('is-active', enable);
        }

        function copySingleVerse(btn) {
            const block = btn.closest('.verse-block');
            const lines = Array.from(block.querySelectorAll('.hemistich-line')).map(l => l.innerText.trim());
            const textToCopy = lines.join(' / ');
            navigator.clipboard.writeText(textToCopy);
            const span = btn.querySelector('span');
            span.innerText = 'کپی شد';
            setTimeout(() => { span.innerText = 'کپی'; }, 1500);
        }

        function copyFullPoem(btn) {
            const title = document.getElementById('poemMainHeading').innerText;
            const verses = Array.from(document.querySelectorAll('.verse-block')).map(b => {
                const lines = Array.from(b.querySelectorAll('.hemistich-line')).map(l => l.innerText.trim());
                return lines.join('\n');
            }).join('\n\n');
            const fullText = `«${title}»\nحافظ شیرازی\n\n${verses}\n\n— برگرفته از آرشیو ادبیات پارسی قاف`;
            navigator.clipboard.writeText(fullText);
            btn.classList.add('is-active');
            setTimeout(() => { btn.classList.remove('is-active'); }, 1500);
        }

        function togglePoemBookmark(btn) {
            btn.classList.toggle('is-active');
            let bookmarks = JSON.parse(localStorage.getItem('qaf_bookmarked_poems') || '[]');
            if (btn.classList.contains('is-active')) {
                if (!bookmarks.includes('غزل شماره ۱')) bookmarks.push('غزل شماره ۱');
            } else {
                bookmarks = bookmarks.filter(p => p !== 'غزل شماره ۱');
            }
            localStorage.setItem('qaf_bookmarked_poems', JSON.stringify(bookmarks));
        }

        function toggleVerseBookmark(btn, verseId) {
            const block = btn.closest('.verse-block');
            block.classList.toggle('is-bookmarked');
            btn.classList.toggle('is-active');
            const isBookmarked = block.classList.contains('is-bookmarked');
            btn.querySelector('span').innerText = isBookmarked ? 'نشان شد' : 'نشان';
            let saved = JSON.parse(localStorage.getItem('qaf_bookmarked_verses') || '[]');
            if (isBookmarked) {
                if (!saved.includes(verseId)) saved.push(verseId);
            } else {
                saved = saved.filter(id => id !== verseId);
            }
            localStorage.setItem('qaf_bookmarked_verses', JSON.stringify(saved));
        }

        function togglePoetBookmark(btn) {
            btn.classList.toggle('is-bookmarked');
            let bookmarks = JSON.parse(localStorage.getItem('qaf_bookmarked_poets') || '[]');
            if (btn.classList.contains('is-bookmarked')) {
                if (!bookmarks.includes('حافظ شیرازی')) bookmarks.push('حافظ شیرازی');
            } else {
                bookmarks = bookmarks.filter(p => p !== 'حافظ شیرازی');
            }
            localStorage.setItem('qaf_bookmarked_poets', JSON.stringify(bookmarks));
        }

        function toggleWorkBookmark(workName, btn) {
            btn.classList.toggle('is-bookmarked');
            let bookmarks = JSON.parse(localStorage.getItem('qaf_bookmarked_works') || '[]');
            if (btn.classList.contains('is-bookmarked')) {
                if (!bookmarks.includes(workName)) bookmarks.push(workName);
            } else {
                bookmarks = bookmarks.filter(w => w !== workName);
            }
            localStorage.setItem('qaf_bookmarked_works', JSON.stringify(bookmarks));
        }

        function recordLastReading() {
            const lastReadData = {
                title: 'غزل شماره ۱',
                author: 'حافظ شیرازی',
                workTitle: 'دیوان اشعار',
                number: '1',
                line1: 'الا یا اَیها السّاقی اَدِر کأساً و ناوِلها',
                line2: 'که عشق آسان نمود اوّل ولی افتاد مشکل‌ها'
            };
            localStorage.setItem('qaf_last_read_poem', JSON.stringify(lastReadData));

            const history = JSON.parse(localStorage.getItem('qaf_reading_history') || '[]');
            const filtered = history.filter(h => h.title !== lastReadData.title || h.workTitle !== lastReadData.workTitle);
            filtered.unshift({ title: lastReadData.title, author: lastReadData.author, workTitle: lastReadData.workTitle });
            localStorage.setItem('qaf_reading_history', JSON.stringify(filtered.slice(0, 20)));
        }

        /* --- PROFILE TABS & BOOKMARKS LOGIC --- */
        function switchMainTab(tabId, btn) {
            document.querySelectorAll('.workspace-tab-btn').forEach(b => b.classList.remove('active'));
            document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
            btn.classList.add('active');
            if (tabId === 'bookmarks') document.getElementById('tabPanelBookmarks').classList.add('active');
            if (tabId === 'history') document.getElementById('tabPanelHistory').classList.add('active');
        }

        function filterByCollection(category, btn) {
            document.querySelectorAll('.collection-chip').forEach(c => c.classList.remove('active'));
            btn.classList.add('active');
            const cards = document.querySelectorAll('#bookmarksUnitsList .bookmark-unit-card');
            cards.forEach(card => {
                const cardCat = card.getAttribute('data-category');
                card.style.display = (category === 'all' || cardCat === category || cardCat === 'all') ? 'flex' : 'none';
            });
        }

        function removeBookmarkUnit(btn, id, type) {
            const keyMap = { poet: 'qaf_bookmarked_poets', work: 'qaf_bookmarked_works', verse: 'qaf_bookmarked_verses', poem: 'qaf_bookmarked_poems' };
            const key = keyMap[type];
            if (key) {
                let items = JSON.parse(localStorage.getItem(key) || '[]');
                items = items.filter(i => String(i) !== String(id));
                localStorage.setItem(key, JSON.stringify(items));
            }
            renderBookmarks();
        }

        function clearReadingHistory() {
            localStorage.removeItem('qaf_reading_history');
            localStorage.removeItem('qaf_last_read_poem');
            renderReadingHistory();
            renderRecentReading();
        }

        /* --- EMPTY STATE TEMPLATES --- */
        function emptyStateHTML(iconSvg, title, sub) {
            return `<div class="empty-state-box">
                <span class="empty-state-icon">${iconSvg}</span>
                <span class="empty-state-title">${title}</span>
                <span class="empty-state-sub">${sub}</span>
            </div>`;
        }

