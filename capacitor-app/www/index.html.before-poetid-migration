            color: var(--ink);
            padding: 10px 16px;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            border-radius: 0;
            width: 100%;
        }

        .modal-save-btn:active {
            border-color: var(--gold);
            color: var(--gold);
