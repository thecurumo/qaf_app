        .collection-chip {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            height: 36px;
            padding: 0 12px;
            background: var(--chalk);
            border: 1px solid var(--stone);
            color: var(--ink);
            font-size: 12px;
            font-weight: 500;
            white-space: nowrap;
            cursor: pointer;
            border-radius: 0;
            transition: all 0.15s ease;
            flex-shrink: 0;
        }

        .collection-chip.active {
            border-color: var(--gold);
            color: var(--gold);
            background: var(--tab-active-bg);
            border-top: 2px solid var(--gold);
        }

        .create-list-action-chip {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            height: 36px;
            padding: 0 12px;
            background: transparent;
            border: 1px dashed var(--gold);
            color: var(--gold);
            font-size: 12px;
            font-weight: 600;
            white-space: nowrap;
            cursor: pointer;
            border-radius: 0;
            flex-shrink: 0;
        }

        .create-list-action-chip:active { background: rgba(191, 160, 84, 0.08); }

        .bookmarks-list-stream, .history-list-stream, .results-cards-list {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .result-group-section {
            display: flex;
            flex-direction: column;
            gap: 14px;
        }

        .empty-state-box {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 8px;
            text-align: center;
            padding: 28px 16px;
            background: var(--chalk);
            border: 1px dashed var(--stone);
        }

        .empty-state-box .empty-state-icon {
            color: var(--stone);
            opacity: 0.7;
        }

        .empty-state-box .empty-state-title {
            font-size: 13.5px;
            font-weight: 600;
            color: var(--ink);
        }

        .empty-state-box .empty-state-sub {
            font-size: 12px;
            color: var(--stone);
            line-height: 1.7;
        }

        .empty-state-box .empty-state-action {
            margin-top: 4px;
            font-size: 12px;
            color: var(--gold);
            font-weight: 600;
        }

        .bookmark-unit-card {
            background: var(--chalk);
            border: 1px solid var(--stone);
            border-top: 2px solid var(--gold);
            padding: 14px 16px;
            display: flex;
            flex-direction: column;
            gap: 10px;
            transition: all 0.2s ease;
        }

        .bookmark-unit-card:active {
            border-color: var(--gold);
            background: var(--input-focus-bg);
            transform: scale(0.98);
        }

        .bookmark-unit-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            font-size: 11px;
            color: var(--stone);
            border-bottom: 0.5px dotted rgba(138, 141, 145, 0.3);
            padding-bottom: 6px;
        }

        .bookmark-type-badge {
            color: var(--gold);
            font-weight: 600;
        }

        .remove-bookmark-btn {
            background: transparent;
            border: none;
            color: var(--stone);
            cursor: pointer;
            font-size: 11px;
            padding: 0 4px;
        }

        .remove-bookmark-btn:active { color: #C2410C; }

        .bookmark-unit-title {
            font-size: 14.5px;
            font-weight: 600;
            color: var(--ink);
            line-height: 1.4;
        }

        .bookmark-unit-sub {
            font-size: 11.5px;
            color: var(--stone);
            margin-top: 2px;
        }

        .bookmark-unit-footer {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            border-top: 0.5px dotted var(--stone);
            padding-top: 8px;
            font-size: 11px;
        }

        .history-item-row {
            background: var(--chalk);
            border: 1px solid var(--stone);
            border-right: 3px solid var(--gold);
            padding: 14px 16px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            transition: all 0.2s ease;
            cursor: pointer;
        }

        .history-item-row:active {
            border-color: var(--gold);
            background: var(--input-focus-bg);
            transform: scale(0.98);
        }

        .history-item-info {
            display: flex;
            flex-direction: column;
            gap: 2px;
            min-width: 0;
        }

        .history-poem-title {
            font-size: 14px;
            font-weight: 600;
            color: var(--ink);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .history-poem-meta {
            font-size: 11px;
            color: var(--stone);
        }

        .history-action-side {
            display: flex;
            align-items: center;
            gap: 8px;
            flex-shrink: 0;
        }

        .clear-history-chip {
            background: transparent;
            border: 1px solid rgba(138, 141, 145, 0.4);
            color: var(--stone);
            padding: 8px 14px;
            font-size: 11.5px;
            cursor: pointer;
            transition: all 0.15s ease;
            border-radius: 0;
            width: 100%;
            text-align: center;
            margin-top: 4px;
        }

        .clear-history-chip:active {
            border-color: #C2410C;
            color: #C2410C;
            background: var(--vellum);
        }

        .backup-minimal-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 8px;
            margin-top: 6px;
        }

        .backup-minimal-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            background: var(--chalk);
            border: 1px solid var(--stone);
            color: var(--ink);
            height: 40px;
            font-size: 12px;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.15s ease;
            border-radius: 0;
            text-align: center;
        }

        .backup-minimal-btn:active {
            border-color: var(--gold);
            color: var(--gold);
            background: var(--vellum);
            transform: scale(0.98);
        }

        /* ==========================================================================
           09. CRYPTO DONATION CARDS (ABOUT PAGE)
           ========================================================================== */
        .crypto-wallets-list {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .crypto-unit-card {
            background: var(--chalk);
            border: 1px solid var(--stone);
            border-top: 2px solid var(--gold);
            padding: 14px 16px;
            display: flex;
            flex-direction: column;
            gap: 10px;
            transition: all 0.2s ease;
        }

        .crypto-unit-card:hover, .crypto-unit-card:active {
            border-color: var(--gold);
            background: var(--input-focus-bg);
        }

        .crypto-unit-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            font-size: 11px;
            color: var(--stone);
            border-bottom: 0.5px dotted rgba(138, 141, 145, 0.3);
            padding-bottom: 6px;
        }

        .crypto-network-badge {
            color: var(--gold);
            font-weight: 600;
        }

        .crypto-name-title {
            font-size: 14.5px;
            font-weight: 600;
            color: var(--ink);
        }

        .crypto-address-box {
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: var(--vellum);
            border: 1px solid var(--stone);
            padding: 8px 12px;
            gap: 10px;
        }

        .crypto-address-text {
            font-family: var(--font-mono);
            font-size: 11.5px;
            color: var(--ink);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            direction: ltr;
            text-align: left;
            user-select: all;
        }

        .crypto-copy-btn {
            background: transparent;
            border: none;
            color: var(--gold);
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 4px;
            font-size: 11.5px;
            font-weight: 600;
            font-family: var(--font-fa);
            flex-shrink: 0;
            transition: opacity 0.15s ease;
        }

        .crypto-copy-btn:active { opacity: 0.6; }

        /* ==========================================================================
           10. VISUAL COLOPHON (لنگر پایانی حرف ق)
           ========================================================================== */
        .app-colophon-anchor {
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 28px 0 12px;
            margin-top: 4px;
            user-select: none;
        }

        .colophon-axis {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 18px;
            width: 100%;
            max-width: 300px;
        }

        .colophon-line {
            flex: 1;
            height: 0.5px;
            background-color: var(--stone);
            opacity: 0.35;
        }

        .colophon-monogram {
            font-size: 26px;
            font-weight: 600;
            color: var(--gold);
            line-height: 1;
            opacity: 0.9;
        }

        /* ==========================================================================
           11. FULL-SCREEN ARCHIVAL MENU & SEARCH OVERLAY
           ========================================================================== */
        .nav-drawer {
            position: fixed;
            inset: 0;
            z-index: 100;
            background: var(--vellum);
            display: flex;
            flex-direction: column;
            visibility: hidden;
            opacity: 0;
            transition: opacity 0.22s ease, visibility 0.22s ease;
        }

        .nav-drawer.is-open { visibility: visible; opacity: 1; }

        .drawer-topbar {
            width: 100%;
            border-bottom: 1px solid rgba(138, 141, 145, 0.2);
            flex-shrink: 0;
        }

        .drawer-topbar-inner {
            max-width: 720px;
            margin: 0 auto;
            width: 100%;
            height: calc(var(--topbar-h) + var(--safe-top));
            padding: var(--safe-top) 16px 0;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .drawer-close-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 40px;
            height: 40px;
            background: transparent;
            border: none;
            color: var(--ink);
            cursor: pointer;
            margin-left: -8px;
        }

        .drawer-body-scroll {
            flex: 1;
            overflow-y: auto;
            max-width: 720px;
            width: 100%;
            margin: 0 auto;
            padding: 0 16px calc(36px + var(--safe-bottom));
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .drawer-links-stack {
            display: flex;
            flex-direction: column;
        }

        .drawer-nav-item {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 18px 0;
            border-bottom: 1px solid rgba(138, 141, 145, 0.2);
            font-size: 15px;
            font-weight: 500;
            color: var(--ink);
            transition: background-color 0.15s ease, color 0.15s ease;
            cursor: pointer;
        }

        .drawer-nav-item:active {
            background-color: var(--chalk);
            color: var(--gold);
        }

        .drawer-nav-item.active {
            color: var(--gold);
            font-weight: 600;
        }

        .drawer-nav-item svg { color: var(--stone); }

        .drawer-footer-block {
            display: flex;
            flex-direction: column;
            gap: 16px;
            margin-top: 36px;
            padding-top: 16px;
        }

        .drawer-theme-btn {
            background: var(--chalk);
            border: 1px solid var(--stone);
            color: var(--ink);
            padding: 11px 16px;
            font-size: 13px;
            font-weight: 500;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            cursor: pointer;
            transition: all 0.2s ease;
            outline: none;
            width: 100%;
            border-radius: 0;
        }

        .drawer-theme-btn:active {
            border-color: var(--gold);
            color: var(--gold);
            transform: scale(0.98);
        }

        .drawer-theme-btn .sun-icon { display: none; }
        .drawer-theme-btn .moon-icon { display: block; }
        .drawer-theme-btn .theme-text-dark { display: none; }
        .drawer-theme-btn .theme-text-light { display: inline; }

        [data-theme="dark"] .drawer-theme-btn .sun-icon { display: block; }
        [data-theme="dark"] .drawer-theme-btn .moon-icon { display: none; }
        [data-theme="dark"] .drawer-theme-btn .theme-text-dark { display: inline; }
        [data-theme="dark"] .drawer-theme-btn .theme-text-light { display: none; }

        /* Search Overlay Sheet */
        .search-overlay {
            position: fixed;
            inset: 0;
            z-index: 105;
            display: flex;
            flex-direction: column;
            visibility: hidden;
            opacity: 0;
            transition: opacity 0.25s ease, visibility 0.25s ease;
        }

        .search-overlay.is-open { visibility: visible; opacity: 1; }

        .search-overlay-scrim {
            position: absolute;
            inset: 0;
            background: var(--overlay-scrim);
        }

        .search-overlay-sheet {
            position: relative;
            margin-top: auto;
            margin-bottom: 0;
            width: 100%;
            background: var(--vellum);
            border-top: 3px solid var(--gold);
            padding: 24px 0 calc(28px + var(--safe-bottom));
            max-height: 88vh;
            overflow-y: auto;
            transform: translateY(100%);
            transition: transform 0.28s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .search-overlay.is-open .search-overlay-sheet { transform: translateY(0); }

        .search-overlay-inner {
            max-width: 720px;
            margin: 0 auto;
            width: 100%;
            padding: 0 16px;
            display: flex;
            flex-direction: column;
            gap: 18px;
        }

        .sheet-header-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .sheet-title {
            font-size: 15.5px;
            font-weight: 600;
            color: var(--ink);
        }

        .global-search-box {
            display: flex;
            align-items: center;
            background: var(--chalk);
            border: 1px solid var(--stone);
            padding: 0 14px;
            height: 48px;
            min-height: 48px;
            flex-shrink: 0;
            width: 100%;
        }

        .global-search-box:focus-within {
            border-color: var(--gold);
            background: var(--input-focus-bg);
            box-shadow: 0 4px 16px rgba(191, 160, 84, 0.12);
        }

        .global-search-box svg {
            color: var(--gold);
            flex-shrink: 0;
            margin-left: 10px;
        }

        .global-search-input {
            width: 100%;
            height: 100%;
            font-family: var(--font-fa);
            font-size: 14.5px;
            color: var(--ink);
            background: transparent;
            border: none;
            outline: none;
        }

        .global-filter-grid {
            display: grid;
            grid-template-columns: 1fr;
            gap: 14px;
        }

        .global-action-bar {
            display: flex;
            flex-direction: column;
            gap: 10px;
            border-top: 0.5px dotted var(--stone);
            padding-top: 16px;
        }

        .global-exec-btn {
            width: 100%;
            background: var(--chalk);
            border: 1px solid var(--stone);
            border-top: 2px solid var(--gold);
            color: var(--ink);
            height: 46px;
            min-height: 46px;
            font-size: 13.5px;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            cursor: pointer;
        }

        .global-exec-btn:active {
            border-color: var(--gold);
            color: var(--gold);
        }

        .global-reset-btn {
            width: 100%;
            background: transparent;
            border: 1px solid rgba(138, 141, 145, 0.4);
            color: var(--stone);
            height: 42px;
            min-height: 42px;
            font-size: 12.5px;
            cursor: pointer;
        }

        /* Modal: Create List */
        .modal-backdrop {
            display: none;
            position: fixed;
            inset: 0;
            background: var(--overlay-scrim);
            z-index: 1000;
            align-items: center;
            justify-content: center;
            padding: 16px;
        }

        .modal-backdrop.open { display: flex; }

        .modal-box {
            background: var(--vellum);
            border: 1px solid var(--stone);
            border-top: 3px solid var(--gold);
            box-shadow: 0 12px 32px rgba(0,0,0,0.25);
            max-width: 440px;
            width: 100%;
            padding: 20px;
            display: flex;
            flex-direction: column;
            gap: 14px;
        }

        .modal-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-bottom: 0.5px dotted rgba(138, 141, 145, 0.4);
            padding-bottom: 8px;
        }

        .modal-title {
            font-size: 15px;
            font-weight: 700;
            color: var(--ink);
        }

        .modal-close-btn {
            background: transparent;
            border: none;
            color: var(--stone);
            cursor: pointer;
            font-size: 16px;
        }

        .modal-field-group {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .modal-field-group label {
            font-size: 11px;
            font-weight: 600;
            color: var(--stone);
        }

        .modal-input {
            width: 100%;
            background: var(--chalk);
            border: 1px solid var(--stone);
            color: var(--ink);
            padding: 10px 12px;
            font-size: 13.5px;
            outline: none;
            border-radius: 0;
            font-family: var(--font-fa);
        }

        .modal-input:focus {
            border-color: var(--gold);
            background: var(--input-focus-bg);
        }

        .modal-save-btn {
            background: var(--chalk);
            border: 1px solid var(--stone);
