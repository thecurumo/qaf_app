        const ICON_BOOKMARK = '<svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path></svg>';
        const ICON_HISTORY = '<svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="9"></circle><polyline points="12 7 12 12 15 15"></polyline></svg>';

        /* --- RENDER: RECENT READING (HOME) --- */
        function renderRecentReading() {
            const container = document.getElementById('recentReadingContent');
            if (!container) return;
            const raw = localStorage.getItem('qaf_last_read_poem');
            const data = raw ? JSON.parse(raw) : null;

            if (!data || !data.title) {
                container.innerHTML = emptyStateHTML(
                    ICON_BOOK,
                    'هنوز شعری نخوانده‌اید',
                    'با انتخاب یک سخنور یا اثر، مطالعه خود را آغاز کنید.'
                );
                return;
            }

            container.innerHTML = `<div class="poem-flat-card" onclick="navigateTo('view-poem-reader')">
                <div class="poem-card-header">
                    <span class="poem-number-badge">${data.title}</span>
                </div>
                <div class="poem-opening-couplet">
                    <div class="hemistich-line">${data.line1}</div>
                    <div class="hemistich-line">${data.line2}</div>
                </div>
                <div class="poem-card-footer">
                    <span class="poem-meta-text">${data.author} • ${data.workTitle}</span>
                    <span class="poem-action-link">خوانش ←</span>
                </div>
            </div>`;
        }

        /* --- STATIC METADATA (used to enrich bookmark cards, same info shown in search results) --- */
