        .inwork-exec-btn:active, .inpoet-exec-btn:active {
            border-color: var(--gold);
            color: var(--gold);
            transform: scale(0.98);
        }

        /* ==========================================================================
           07. POEM READER STYLES & ZEN MODE
           ========================================================================== */
        .poem-header-plaque {
            background: var(--chalk);
            border: 1px solid var(--stone);
            border-top: 3px solid var(--gold);
            padding: 18px 16px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.03);
            position: relative;
        }

        .poem-header-info {
            display: flex;
            flex-direction: column;
            gap: 2px;
        }

        .poem-main-title {
            font-size: 19px;
            font-weight: 700;
            color: var(--ink);
            line-height: 1.2;
            margin: 0;
        }

        .poem-sub-author-link {
            font-size: 13px;
            color: var(--gold);
            font-weight: 500;
            cursor: pointer;
        }

        .poem-header-actions {
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .poem-tool-btn {
            background: transparent;
            border: 1px solid var(--stone);
            color: var(--stone);
