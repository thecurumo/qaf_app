        }

        .inwork-search-input, .inpoet-search-input {
            width: 100%;
            height: 100%;
            font-family: var(--font-fa);
            font-size: 14px;
            color: var(--ink);
            background: transparent;
            border: none;
            outline: none;
        }

        .inwork-exec-btn, .inpoet-exec-btn {
            background: var(--vellum);
            border: 1px solid var(--stone);
            border-top: 2px solid var(--gold);
            color: var(--ink);
