            transition: border-color 0.2s ease, background-color 0.2s ease;
        }

        .verse-block:hover, .verse-block:active {
            border-color: var(--gold);
            background-color: var(--input-focus-bg);
        }

        .verse-block.is-bookmarked {
            border-right: 3px solid var(--gold);
        }

        .verse-meta-bar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            font-size: 11px;
            color: var(--stone);
            border-bottom: 0.5px dotted rgba(138, 141, 145, 0.3);
            padding-bottom: 6px;
        }

        .verse-number-badge {
            font-family: var(--font-fa);
            font-weight: 600;
            color: var(--gold);
        }

        .verse-micro-actions {
            display: inline-flex;
            align-items: center;
            gap: 10px;
        }

        .verse-action-link-btn {
            background: transparent;
            border: none;
            color: var(--stone);
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 4px;
            font-size: 11px;
            font-family: var(--font-fa);
            transition: color 0.15s ease;
        }

        .verse-action-link-btn:active, .verse-action-link-btn.is-active {
            color: var(--gold);
            font-weight: 600;
        }

        .verse-content-layout {
            display: flex;
            flex-direction: column;
            gap: 4px;
            width: 100%;
        }

        .poem-pagination-bar {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
            margin-top: 6px;
        }

        .poem-nav-card {
            background: var(--chalk);
            border: 1px solid var(--stone);
            border-top: 2px solid var(--gold);
            padding: 12px 14px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            font-size: 12.5px;
            font-weight: 600;
            color: var(--ink);
            transition: all 0.15s ease;
            min-height: 48px;
            cursor: pointer;
        }

        .poem-nav-card:active {
            border-color: var(--gold);
            background: var(--input-focus-bg);
            color: var(--gold);
            transform: scale(0.98);
        }

        .poem-nav-card.disabled {
            opacity: 0.4;
            pointer-events: none;
            border-top-color: var(--stone);
        }

        /* ZEN MODE */
        body.zen-active .app-topbar,
        body.zen-active .poem-pagination-bar,
        body.zen-active .verse-meta-bar,
        body.zen-active .app-colophon-anchor {
            display: none !important;
        }

        body.zen-active .page-container {
            padding-top: calc(24px + var(--safe-top));
        }

        body.zen-active .poem-header-plaque {
            border: none;
            background: transparent;
            box-shadow: none;
            padding: 0 0 16px 0;
            border-bottom: 0.5px dotted rgba(138, 141, 145, 0.35);
            text-align: center;
            justify-content: center;
        }

        body.zen-active .poem-header-actions {
            display: none;
        }

        body.zen-active .verse-block {
            background: transparent;
            border: none;
            border-bottom: 0.5px dotted rgba(138, 141, 145, 0.25);
            padding: 16px 0;
        }

        /* ==========================================================================
           08. BOOKMARKS & HISTORY (PROFILE)
           ========================================================================== */
        .workspace-tabs-bar {
            display: grid;
            grid-template-columns: 1fr 1fr;
            background: var(--chalk);
            border: 1px solid var(--stone);
            width: 100%;
        }

        .workspace-tab-btn {
            background: transparent;
            border: none;
            border-bottom: 2px solid transparent;
            color: var(--stone);
            padding: 10px 14px;
            min-height: 44px;
            font-size: 13.5px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.15s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            border-radius: 0;
        }

        .workspace-tab-btn.active {
            background: var(--tab-active-bg);
            color: var(--gold);
            border-bottom-color: var(--gold);
        }

        .tab-panel {
            display: none;
            flex-direction: column;
            gap: 20px;
        }

        .tab-panel.active { display: flex; }

        .categories-scroll-row {
