            margin-top: 12px;
            font-size: 11px;
            color: var(--stone);
        }

        .subsection-footer span:last-child, .poet-work-item-footer span:last-child {
            color: var(--gold);
            font-weight: 500;
        }

        /* In-Entity Dedicated Search */
        .inwork-search-section, .inpoet-search-section {
            background: var(--chalk);
            border: 1px solid var(--stone);
            border-top: 2.5px solid var(--gold);
            padding: 16px;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .inwork-search-box, .inpoet-search-box {
            display: flex;
            align-items: center;
            background: var(--vellum);
            border: 1px solid var(--stone);
            padding: 0 14px;
            height: 46px;
