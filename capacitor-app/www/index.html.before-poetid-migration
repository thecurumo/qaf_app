            height: 36px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.15s ease;
            flex-shrink: 0;
            border-radius: 0;
        }

        .poem-tool-btn:active { transform: scale(0.92); }
        .poem-tool-btn.is-active {
            border-color: var(--gold);
            color: var(--gold);
            background: rgba(191, 160, 84, 0.08);
        }

        .verses-canvas {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .verse-block {
            background: var(--chalk);
            border: 1px solid var(--stone);
            padding: 14px 16px;
            display: flex;
            flex-direction: column;
            gap: 8px;
