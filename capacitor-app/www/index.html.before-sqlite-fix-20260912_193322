  function navigateTo(viewId, params = {}) {
    document.querySelectorAll('.spa-view').forEach(v => v.classList.remove('active-view'));
    const target = $(viewId);
    if (!target) return;
    target.classList.add('active-view');
    state.currentView = viewId;
    window.scrollTo({top:0, behavior:'smooth'});

    const sub = $('topbarSubtext');
    const labels = {
      'view-home':'آرشیو ادبیات پارسی','view-poets':'دانشنامه سخنوران','view-works':'گنجینه آثار و دیوان‌ها',
      'view-poet-detail':'اطلاعات سخنور','view-work-hierarchical':'اطلاعات اثر','view-work-flat':'اطلاعات اثر',
      'view-poem-reader':'خوانش شعر','view-search':'نتایج جستجو','view-profile':'بایگانی و نشان‌ها','view-about':'درباره قاف'
    };
    if (sub) sub.innerText = labels[viewId] || 'آرشیو ادبیات پارسی';

    document.querySelectorAll('.drawer-nav-item').forEach(el => el.classList.remove('active'));
    const navMap = {'view-home':'navItem-home','view-poets':'navItem-poets','view-works':'navItem-works','view-profile':'navItem-profile','view-about':'navItem-about'};
    if (navMap[viewId]) $(navMap[viewId])?.classList.add('active');

    if (!state.dbReady) return;

    if (viewId === 'view-home') loadHome();
    if (viewId === 'view-poets') loadPoets(true);
    if (viewId === 'view-works') loadWorks(true);
    if (viewId === 'view-poet-detail' && params.poetId != null) loadPoetDetail(Number(params.poetId));
    if ((viewId === 'view-work-flat' || viewId === 'view-work-hierarchical') && params.catId != null) loadWork(Number(params.catId), viewId === 'view-work-flat');
    if (viewId === 'view-poem-reader' && params.poemId != null) loadPoem(Number(params.poemId));
    if (viewId === 'view-search') {
      if (params.query != null) $('searchResultsInput').value = params.query;
      populateGlobalFilters().then(performLiveFilter);
    }
    if (viewId === 'view-profile') {
      renderBookmarks(); renderReadingHistory();
      if (params.tab) {
        const btn = document.querySelectorAll('.workspace-tab-btn')[params.tab === 'history' ? 1 : 0];
        if (btn) switchMainTab(params.tab, btn);
      }
    }
  }

  async function loadPoets(reset = false) {
    if (!state.dbReady) return;
    if (reset) state.poetOffset = 0;
    const q = normalize($('poetSearchInput')?.value);
    const century = $('poetCenturyFilter')?.value || '';
    const city = $('poetCityFilter')?.value || '';
    const sort = $('poetSortFilter')?.value || 'historical-asc';
    const where = [], values = [];
    if (q) { where.push('(LOWER(name) LIKE ? OR LOWER(COALESCE(description,\'\')) LIKE ?)'); values.push(`%${q}%`,`%${q}%`); }
    if (century) { where.push('CAST(century_id AS TEXT)=?'); values.push(century); }
    if (city) { where.push('(COALESCE(birthplace,\'\') LIKE ? OR COALESCE(deathplace,\'\') LIKE ?)'); values.push(`%${city}%`,`%${city}%`); }
    const order = sort === 'alphabetical' ? 'name COLLATE NOCASE ASC' : sort === 'historical-desc' ? 'COALESCE(birth_year,-1) DESC,name' : 'COALESCE(birth_year,999999) ASC,name';
    const sql = `SELECT id,name,cat_id,description,century_id,birth_year,death_year,birthplace,deathplace FROM poet ${where.length?'WHERE '+where.join(' AND '):''} ORDER BY ${order} LIMIT ${PAGE_SIZE} OFFSET ${state.poetOffset}`;
    const data = await dbQuery(sql, values);
    const grid = $('poetsGrid');
    if (reset && grid) grid.innerHTML = '';
    if (grid) grid.insertAdjacentHTML('beforeend', data.map(poetCard).join(''));
    state.poetOffset += data.length;
    if ($('poetsEmptyBox')) $('poetsEmptyBox').style.display = (!grid || !grid.children.length) ? 'flex' : 'none';
    if ($('poetsLoadMoreBtn')) $('poetsLoadMoreBtn').style.display = data.length === PAGE_SIZE ? 'inline-flex' : 'none';
  }

