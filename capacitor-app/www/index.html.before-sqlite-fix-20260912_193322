  async function loadPoem(poemId) {
    const poem = (await dbQuery(`SELECT po.id AS poem_id,po.title,po.cat_id,c.text AS cat_title,p.id AS poet_id,p.name AS poet_name,p.century_id,p.birthplace
      FROM poem po JOIN cat c ON c.id=po.cat_id JOIN poet p ON p.id=c.poet_id WHERE po.id=? LIMIT 1`,[poemId]))[0];
    if (!poem) return;
    state.currentPoem = poem;
    const all = await dbQuery('SELECT id FROM poem WHERE cat_id=? ORDER BY id',[poem.cat_id]);
    state.currentPoemIndex = all.findIndex(x => Number(x.id) === Number(poemId));

    $('poemMainHeading').innerText = poem.title || '—';
    $('poemSubAuthor').innerText = `${poem.poet_name || ''} • ${poem.cat_title || ''}`;
    $('poemSubAuthor').onclick = () => navigateTo('view-poet-detail',{poetId:poem.poet_id});

    const verses = await dbQuery('SELECT poem_id,vorder,position,text FROM verse WHERE poem_id=? ORDER BY vorder,position',[poemId]);
    const grouped = [];
    const byOrder = new Map();
    verses.forEach(v => {
      const key = String(v.vorder);
      if (!byOrder.has(key)) byOrder.set(key, []);
      byOrder.get(key).push(v);
    });
    byOrder.forEach((items, key) => grouped.push({order:key, items}));
    const container = $('versesContainer');
    container.innerHTML = grouped.map((g, i) => {
      const lines = g.items.map(v => `<div class="hemistich-line">${esc(v.text)}</div>`).join('');
      const verseKey = `${poemId}:${g.order}`;
      const marked = getBookmarks('verse').some(x => String(x.id) === verseKey);
      return `<article class="verse-block ${marked?'is-bookmarked':''}" data-verse-id="${esc(verseKey)}">
        <div class="verse-meta-bar"><span class="verse-number-badge">بیت ${faNum(i+1)}</span>
          <div class="verse-micro-actions"><button type="button" class="verse-action-link-btn ${marked?'is-active':''}" onclick="toggleVerseBookmark(this,'${esc(verseKey)}')"><span>${marked?'نشان شد':'نشان'}</span></button>
          <button type="button" class="verse-action-link-btn" onclick="copySingleVerse(this)"><span>کپی</span></button></div>
        </div><div class="verse-content-layout">${lines}</div>
      </article>`;
    }).join('') || emptyState('متنی برای این شعر ثبت نشده است','این شعر در پایگاه داده بیتی ندارد.');

    const bm = $('poemBookmarkBtn');
    bm.classList.toggle('is-active', getBookmarks('poem').some(x => String(x.id) === String(poemId)));
    updatePoemPagination(all);
    recordLastReading(poem, grouped);
  }

  function updatePoemPagination(all) {
    const i = state.currentPoemIndex;
    const prev = $('prevPoemBtn'), next = $('nextPoemBtn');
    const prevId = i > 0 ? Number(all[i-1].id) : null;
    const nextId = i >= 0 && i < all.length - 1 ? Number(all[i+1].id) : null;
    if (prev) {
      prev.classList.toggle('disabled', !prevId);
      prev.onclick = prevId ? () => loadPoem(prevId) : null;
      $('prevPoemLabel').innerText = prevId ? 'شعر قبلی' : 'ابتدای این اثر';
    }
    if (next) {
      next.classList.toggle('disabled', !nextId);
      next.onclick = nextId ? () => loadPoem(nextId) : null;
      $('nextPoemLabel').innerText = nextId ? 'شعر بعدی' : 'پایان این اثر';
    }
  }

