    else action=`navigateTo('view-poem-reader',{poemId:${Number(getBookmarks('verse').find(x=>String(x.id??x)===String(id))?.poemId || 0)}})`;
    return `<div class="bookmark-unit-card" data-category="${esc(type)}"><div class="bookmark-unit-header"><span class="bookmark-type-badge">${esc(badge)}</span><button type="button" class="remove-bookmark-btn" onclick="event.stopPropagation();removeBookmarkUnit(this,'${safeId}','${esc(type)}')">حذف</button></div><div onclick="${action}"><div class="bookmark-unit-title">${esc(title)}</div></div><div class="bookmark-unit-footer"><span class="bookmark-action-link">باز کردن ←</span></div></div>`;
