  async function performLiveFilter() {
    if (!state.dbReady) return;
    const query = normalize($('searchResultsInput')?.value);
    const scope = $('scopeSelect')?.value || 'all';
    const poetId = $('poetSelect')?.value || '';
    const century = $('centurySelect')?.value || '';
    const show = (id, yes) => { const el=$(id); if(el) el.style.display=yes?'flex':'none'; };
    const empty = (id, yes) => { const el=$(id); if(el) el.style.display=yes?'block':'none'; };

    const poetWhere=[], poetVals=[];
    if(query){ poetWhere.push('(LOWER(name) LIKE ? OR LOWER(COALESCE(description,\'\')) LIKE ?)'); poetVals.push(`%${query}%`,`%${query}%`); }
    if(century){ poetWhere.push('CAST(century_id AS TEXT)=?'); poetVals.push(century); }
    const poets = scope==='works'||scope==='verses' ? [] : await dbQuery(`SELECT id,name,century_id,birthplace,birth_year,death_year,deathplace FROM poet ${poetWhere.length?'WHERE '+poetWhere.join(' AND '):''} ORDER BY name LIMIT 30`,poetVals);
    $('poetsGridResults').innerHTML = poets.map(p=>`<div class="bookmark-unit-card" data-name="${esc(p.name)}" onclick="navigateTo('view-poet-detail',{poetId:${Number(p.id)}})"><div class="bookmark-unit-header"><span class="bookmark-type-badge">سخنور</span></div><div><div class="bookmark-unit-title">${esc(p.name)}</div><div class="bookmark-unit-sub">${esc(p.birthplace||'')} • ${esc(p.century_id!=null?`قرن ${faNum(p.century_id)} هـ.ق`:'')}</div></div><div class="bookmark-unit-footer"><span class="bookmark-action-link">مشاهده ←</span></div></div>`).join('');
    show('poetsResultSection', scope==='all'||scope==='poets'); empty('poetsEmptyMsg', poets.length===0 && (scope==='all'||scope==='poets'));

    const workWhere=[], workVals=[];
    if(query){ workWhere.push('(LOWER(c.text) LIKE ? OR LOWER(p.name) LIKE ?)'); workVals.push(`%${query}%`,`%${query}%`); }
    if(poetId){ workWhere.push('p.id=?'); workVals.push(poetId); }
    if(century){ workWhere.push('CAST(p.century_id AS TEXT)=?'); workVals.push(century); }
    const works = scope==='poets'||scope==='verses' ? [] : await dbQuery(`SELECT c.id AS cat_id,c.text AS title,p.id AS poet_id,p.name AS poet_name,p.century_id FROM cat c JOIN poet p ON p.id=c.poet_id ${workWhere.length?'WHERE '+workWhere.join(' AND '):''} ORDER BY c.text LIMIT 30`,workVals);
    $('worksGridResults').innerHTML = works.map(w=>`<div class="bookmark-unit-card" onclick="navigateTo('view-work-hierarchical',{catId:${Number(w.cat_id)}})"><div class="bookmark-unit-header"><span class="bookmark-type-badge">اثر</span></div><div><div class="bookmark-unit-title">${esc(w.title)}</div><div class="bookmark-unit-sub">${esc(w.poet_name)} • ${esc(w.century_id!=null?`قرن ${faNum(w.century_id)} هـ.ق`:'')}</div></div><div class="bookmark-unit-footer"><span class="bookmark-action-link">مطالعه ←</span></div></div>`).join('');
    show('worksResultSection', scope==='all'||scope==='works'); empty('worksEmptyMsg', works.length===0 && (scope==='all'||scope==='works'));

    const verseWhere=['1=1'], verseVals=[];
    if(query){ verseWhere.push('LOWER(v.text) LIKE ?'); verseVals.push(`%${query}%`); }
    if(poetId){ verseWhere.push('p.id=?'); verseVals.push(poetId); }
    if(century){ verseWhere.push('CAST(p.century_id AS TEXT)=?'); verseVals.push(century); }
    const verses = scope==='poets'||scope==='works' ? [] : await dbQuery(`SELECT v.poem_id,v.vorder,v.position,v.text,po.title,p.name AS poet_name,p.id AS poet_id,p.century_id,c.text AS cat_title FROM verse v JOIN poem po ON po.id=v.poem_id JOIN cat c ON c.id=po.cat_id JOIN poet p ON p.id=c.poet_id WHERE ${verseWhere.join(' AND ')} ORDER BY v.poem_id,v.vorder,v.position LIMIT 50`,verseVals);
    $('versesGridResults').innerHTML = verses.map(v=>`<div class="bookmark-unit-card" onclick="navigateTo('view-poem-reader',{poemId:${Number(v.poem_id)}})"><div class="bookmark-unit-header"><span class="bookmark-type-badge">بیت</span></div><div><div class="bookmark-unit-title" style="font-weight:400;font-size:13.5px;line-height:1.85;">${esc(v.text)}</div><div class="bookmark-unit-sub">${esc(v.poet_name)} • ${esc(v.poem_title||'')}</div></div><div class="bookmark-unit-footer"><span class="bookmark-action-link">خوانش ←</span></div></div>`).join('');
    show('versesResultSection', scope==='all'||scope==='verses'); empty('versesEmptyMsg', verses.length===0 && (scope==='all'||scope==='verses'));
  }

