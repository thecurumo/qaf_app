  <!-- ============================================================
         13. JAVASCRIPT LOGIC & SPA ROUTER
         ============================================================ -->
  <script>
   (() => {
  'use strict';

  const DB_NAME = 'qaf';
  const PAGE_SIZE = 60;
  const state = {
    db: null,
    dbReady: false,
    currentView: 'view-home',
    currentPoet: null,
    currentCat: null,
    currentPoem: null,
    currentPoemIndex: null,
    poetOffset: 0,
    workOffset: 0,
    flatPoemOffset: 0,
    searchTimer: null,
    poetSearchTimer: null,
    workSearchTimer: null,
    customLists: JSON.parse(localStorage.getItem('qaf_custom_lists') || '[]')
  };

  const $ = id => document.getElementById(id);
  const rows = result => (result && Array.isArray(result.values)) ? result.values : [];
  const esc = value => String(value ?? '').replace(/[&<>"']/g, ch => ({
    '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'
  }[ch]));
  const num = value => Number.isFinite(Number(value)) ? Number(value) : null;
  const faNum = value => value == null || value === '' ? '—' : String(value).replace(/\d/g, d => '۰۱۲۳۴۵۶۷۸۹'[d]);
  const normalize = value => String(value ?? '').trim().toLowerCase();

  function emptyState(title, sub) {
    return `<div class="empty-state-box">${ICON_BOOKMARK}<span class="empty-state-title">${esc(title)}</span><span class="empty-state-sub">${esc(sub)}</span></div>`;
  }

  const ICON_BOOKMARK = '<span class="empty-state-icon"><svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M19 21l-7-5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path></svg></span>';

  async function dbQuery(statement, values = []) {
    if (!state.dbReady || !state.db) throw new Error('پایگاه داده هنوز آماده نیست.');
    const result = await state.db.query({database: DB_NAME, statement, values, readonly: true});
    return rows(result);
  }

  async function initDatabase() {
    const sqlite = window.Capacitor?.Plugins?.CapacitorSQLite;
    if (!sqlite) throw new Error('پلاگین CapacitorSQLite در محیط اجرا در دسترس نیست.');

    try {
      await sqlite.copyFromAssets(true);
    } catch (e) {
      console.warn('copyFromAssets:', e);
    }

    try {
      await sqlite.createConnection({
        database: DB_NAME,
        version: 1,
        encrypted: false,
        mode: 'no-encryption',
        readonly: false
      });
    } catch (e) {
      console.warn('createConnection:', e);
    }

    try {
      await sqlite.open({database: DB_NAME, readonly: false});
    } catch (e) {
      const message = String(e?.message || e);
      if (!/already|open/i.test(message)) throw e;
    }

    state.db = sqlite;
    state.dbReady = true;

    // Verify the four application tables before rendering any content.
    await dbQuery('SELECT 1 FROM poet LIMIT 1');
    await dbQuery('SELECT 1 FROM cat LIMIT 1');
    await dbQuery('SELECT 1 FROM poem LIMIT 1');
    await dbQuery('SELECT 1 FROM verse LIMIT 1');
    const poetCount = (await dbQuery('SELECT COUNT(*) AS cnt FROM poet'))[0]?.cnt ?? 0;
    const poemCount = (await dbQuery('SELECT COUNT(*) AS cnt FROM poem'))[0]?.cnt ?? 0;
    const verseCount = (await dbQuery('SELECT COUNT(*) AS cnt FROM verse'))[0]?.cnt ?? 0;
    const sub = $('topbarSubtext');
    if (sub) sub.innerText = `سخنوران ${faNum(poetCount)} • اشعار ${faNum(poemCount)} • ابیات ${faNum(verseCount)}`;

    await loadHome();
    await populateGlobalFilters();
  }

  function setDbError(error) {
    console.error('QAF SQLite:', error);
    const sub = $('topbarSubtext');
    if (sub) sub.innerText = 'خطا در اتصال پایگاه داده';
    const home = $('recentReadingContent');
    if (home) home.innerHTML = emptyState('پایگاه داده در دسترس نیست', error?.message || 'اتصال به SQLite انجام نشد.');
  }

  function metadata(parts) {
    return parts.filter(Boolean).map(x => `<div class="metadata-unit">${x}</div>`).join('<div class="metadata-divider"></div>');
  }

  function poetAvatar(name) {
    return esc(String(name || '—').trim().charAt(0) || '•');
  }

  function poetCard(p) {
    const yearText = p.birth_year || p.death_year ? `${faNum(p.birth_year)} — ${faNum(p.death_year)}` : '—';
    return `<div class="poet-card" data-name="${esc(p.name)}" data-year="${esc(p.birth_year ?? '')}" onclick="navigateTo('view-poet-detail',{poetId:${Number(p.id)}})">
      <div class="poet-avatar">${poetAvatar(p.name)}</div>
      <div class="poet-name">${esc(p.name)}</div>
      <div class="poet-dates">${yearText}</div>
      <div class="poet-geo-meta"><div class="geo-item"><span class="geo-label">زادگاه</span><span class="geo-val">${esc(p.birthplace || '—')}</span></div><div class="geo-divider"></div><div class="geo-item"><span class="geo-label">آرامگاه</span><span class="geo-val">${esc(p.deathplace || '—')}</span></div></div>
    </div>`;
  }

