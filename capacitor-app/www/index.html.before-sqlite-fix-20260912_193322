    const poetCent = $('poetCenturyFilter');
    const poetCity = $('poetCityFilter');
    if (poetCent && poetCent.options.length <= 1) centuries.forEach(x => poetCent.insertAdjacentHTML('beforeend', `<option value="${esc(x.century_id)}">قرن ${faNum(x.century_id)} هـ.ق</option>`));
    if (poetCity && poetCity.options.length <= 1) cities.forEach(x => poetCity.insertAdjacentHTML('beforeend', `<option value="${esc(x.birthplace)}">${esc(x.birthplace)}</option>`));
  }

  async function populateGlobalFilters() {
    if (!state.dbReady) return;
    const poets = await dbQuery('SELECT id,name FROM poet ORDER BY name COLLATE NOCASE');
    const centuries = await dbQuery('SELECT DISTINCT century_id FROM poet WHERE century_id IS NOT NULL ORDER BY century_id');
    const targets = [$('poetSelect'), $('globalPoetFilter')].filter(Boolean);
    targets.forEach(sel => {
      if (sel.options.length > 1) return;
      poets.forEach(p => sel.insertAdjacentHTML('beforeend', `<option value="${esc(p.id)}">${esc(p.name)}</option>`));
    });
    const c = $('centurySelect');
    if (c && c.options.length <= 1) centuries.forEach(x => c.insertAdjacentHTML('beforeend', `<option value="${esc(x.century_id)}">قرن ${faNum(x.century_id)} هـ.ق</option>`));
    await populateDirectoryFilters();
    const wp = $('workPoetFilter');
    const wc = $('workCenturyFilter');
    if (wp && wp.options.length <= 1) poets.forEach(p => wp.insertAdjacentHTML('beforeend', `<option value="${esc(p.id)}">${esc(p.name)}</option>`));
    if (wc && wc.options.length <= 1) centuries.forEach(x => wc.insertAdjacentHTML('beforeend', `<option value="${esc(x.century_id)}">قرن ${faNum(x.century_id)} هـ.ق</option>`));
  }

