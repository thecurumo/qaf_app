<script>
/*
 * QAF SQLite Diagnostic
 * Temporary diagnostic for @capacitor-community/sqlite 8.1.1
 */
(async function qafSQLiteDiagnostic() {
    const sqlite = window.Capacitor?.Plugins?.CapacitorSQLite;

    const log = (step, value) => {
        try {
            const output =
                typeof value === 'string'
                    ? value
                    : JSON.stringify(value, null, 2);

            console.log(`QAF SQLITE DIAGNOSTIC [${step}]: ${output}`);
        } catch (e) {
            console.log(`QAF SQLITE DIAGNOSTIC [${step}]:`, value);
        }
    };

    log('START', 'Diagnostic started');

    if (!sqlite) {
        log('PLUGIN', 'CapacitorSQLite NOT AVAILABLE');
        return;
    }

    log('PLUGIN', 'CapacitorSQLite available');

    // --------------------------------------------------------
    // 1. Check database existence
    // --------------------------------------------------------
    try {
        const result = await sqlite.isDBExists({
            database: 'qaf'
        });
        log('isDBExists', result);
    } catch (e) {
        log('isDBExists ERROR', e);
    }

    // --------------------------------------------------------
    // 2. Check connection BEFORE createConnection
    // --------------------------------------------------------
    try {
        const result = await sqlite.isConnection({
            database: 'qaf',
            readonly: false
        });
        log('isConnection BEFORE', result);
    } catch (e) {
        log('isConnection BEFORE ERROR', e);
    }

    // --------------------------------------------------------
    // 3. createConnection
    // --------------------------------------------------------
    try {
        const result = await sqlite.createConnection({
            database: 'qaf',
            version: 1,
            encrypted: false,
            mode: 'no-encryption',
            readonly: false
        });

        log('createConnection', result);
    } catch (e) {
        log('createConnection ERROR', e);
    }

    // --------------------------------------------------------
    // 4. Check connection AFTER createConnection
    // --------------------------------------------------------
    try {
        const result = await sqlite.isConnection({
            database: 'qaf',
            readonly: false
        });

        log('isConnection AFTER', result);
    } catch (e) {
        log('isConnection AFTER ERROR', e);
    }

    // --------------------------------------------------------
    // 5. open
    // --------------------------------------------------------
    try {
        const result = await sqlite.open({
            database: 'qaf',
            readonly: false
        });

        log('open', result);
    } catch (e) {
        log('open ERROR', e);
    }

    // --------------------------------------------------------
    // 6. Check actual DB open state
    // --------------------------------------------------------
    try {
        const result = await sqlite.isDBOpen({
            database: 'qaf',
            readonly: false
        });

        log('isDBOpen', result);
    } catch (e) {
        log('isDBOpen ERROR', e);
    }

    // --------------------------------------------------------
    // 7. Get tables
    // --------------------------------------------------------
    try {
        const result = await sqlite.getTableList({
            database: 'qaf',
            readonly: true
        });

        log('getTableList', result);
    } catch (e) {
        log('getTableList ERROR', e);
    }

    // --------------------------------------------------------
    // 8. Test poet table
    // --------------------------------------------------------
    try {
        const result = await sqlite.query({
            database: 'qaf',
            statement: 'SELECT 1 FROM poet LIMIT 1',
            values: [],
            readonly: true
        });

        log('QUERY poet', result);
    } catch (e) {
        log('QUERY poet ERROR', e);
    }

    log('END', 'Diagnostic finished');
})();
</script>

